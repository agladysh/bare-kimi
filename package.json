{
  "name": "@agladysh/bare-kimi",
  "version": "0.1.0",
  "description": "Run kimi (Kimi Code CLI) headless against an isolated KIMI_CODE_HOME, on the operator's own login. Library first; the CLI is its worked example.",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./home": "./src/home.ts",
    "./events": "./src/events.ts",
    "./preload": "./src/preload.ts"
  },
  "bin": {
    "bare-kimi": "bin/bare-kimi.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "author": "Alexander Gladysh <agladysh@gmail.com>",
  "keywords": [
    "kimi",
    "kimi-code",
    "headless",
    "cli",
    "agent"
  ]
}
